# ---------------------------------------------------------------------------
# Fancy Finery — environment variables
# Copy to `.env` and fill in. `.env*` is git-ignored; never commit real values.
# ---------------------------------------------------------------------------

# Supabase — server-side (new API key format)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx      # browser-safe (RLS enforced)
SUPABASE_SECRET_KEY=sb_secret_xxx                # SERVER ONLY — bypasses RLS
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Supabase — browser (mirror of the two browser-safe values above).
# Next.js only exposes vars prefixed NEXT_PUBLIC_ to client bundles.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Payments — leave a key blank to keep that provider dormant (pay-on-delivery).
# Use TEST keys first, prove the flow end to end, then swap to live keys.
#
# Paystack settles NGN + USD; Stripe settles EUR + GBP. Routing is automatic by
# the order's currency (see src/infrastructure/payments/providers.ts).
#
# Paystack (SERVER ONLY secret; public key reserved for future inline checkout)
# PAYSTACK_SECRET_KEY=sk_test_xxx
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
#
# Stripe (SERVER ONLY secret + webhook signing secret from the dashboard, for
# the endpoint https://<your-site>/api/stripe/webhook, or `stripe listen`)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Frontend URL — the canonical storefront origin. Payment redirect/callback
# URLs, email + unsubscribe links, sitemap/OG metadata and the default email
# sending domain are all built from it. Origin only: scheme + host (+ port), no
# trailing slash. Must be the real origin in production, else callbacks and
# email links point at localhost.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000        # prod: https://your-domain.com

# AI Concierge (Anthropic) — SERVER ONLY. The floating assistant only appears
# when this key is present AND an admin enables it in Admin → AI Concierge.
# ANTHROPIC_API_KEY=sk-ant-...

# Cron (Vercel Scheduled Functions — see vercel.json)
# When set, /api/cron/* requires `Authorization: Bearer <CRON_SECRET>`.
# Vercel sends this header automatically for scheduled invocations.
# Guards both the newsletter and payment-reconciliation cron endpoints.
# CRON_SECRET=generate-a-long-random-string

# Email — Resend is the house provider, and carries EVERY message the app sends
# itself: order confirmations, payment receipts, status/tracking updates,
# colour-request alerts, the concierge hand-off alert, and the Privé Circle
# newsletter. The other providers below are drop-in escape hatches.
#
# Mail only lands once BOTH are true:
#   1. RESEND_API_KEY is set (resend.com/api-keys — "Sending" access suffices).
#   2. EMAIL_FROM's domain is verified in Resend → Domains, with the DKIM/SPF
#      records it issues added to that domain's DNS. Resend cannot send from an
#      unverified domain, and never from gmail.com — which is why replies are
#      routed with EMAIL_REPLY_TO instead of sending AS the gmail mailbox.
# Unset: dev logs each send; production logs an error rather than a silent OK.
#
# Supabase Auth mail (confirmation, password reset, magic link) is sent BY
# Supabase and needs the key wired in separately, under
# Project Settings → Authentication → SMTP Settings:
#   Host smtp.resend.com  Port 465  User resend  Pass <RESEND_API_KEY>
# See supabase/templates/README.md.
#
# RESEND_API_KEY=re_xxx
# EMAIL_PROVIDER=resend        # resend|mailchimp|klaviyo|brevo|mailgun|ses|postmark|convertkit
# EMAIL_FROM="Fancy Finery <orders@your-domain.com>" # verified domain; quote it
# EMAIL_REPLY_TO=you@gmail.com # where customer replies land; no verification needed
# IP_HASH_SALT=change-me       # salts the hashed signup IPs used for rate limiting
#
# NEWSLETTER_PROVIDER is the former name of EMAIL_PROVIDER, still honoured.
# POSTMARK_SERVER_TOKEN=xxx
# POSTMARK_STREAM=broadcast
# BREVO_API_KEY=xkeysib-xxx
# MAILGUN_API_KEY=key-xxx
# MAILGUN_DOMAIN=mg.your-domain.com
# KLAVIYO_API_KEY=pk_xxx
# MAILCHIMP_API_KEY=xxx        # Mandrill (Mailchimp Transactional) key
# CONVERTKIT_API_KEY=xxx
# AWS_SES_ACCESS_KEY=xxx       # SES also needs the SDK — see email-provider.ts
