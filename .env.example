# ---------------------------------------------------------------------------
# Fancy Finery — environment variables
# Copy to `.env` and fill in. `.env*` is git-ignored; never commit real values.
#
# Supabase has been fully replaced by our own Postgres + Better Auth + MinIO,
# all in Docker on the VPS. Deployment is Docker Compose behind Caddy — there is
# no Vercel involvement anywhere in this project. See docs/MIGRATION_PLAN.md.
# ---------------------------------------------------------------------------


# ===========================================================================
# DATABASE — own Postgres container
# ===========================================================================
# These three bootstrap the `postgres` service in docker-compose.yml. Generate
# a long random password; it never leaves the VPS.
POSTGRES_USER=fancy
POSTGRES_PASSWORD=generate-a-long-random-password
POSTGRES_DB=fancy

# What the app connects with. Inside Compose the host is the SERVICE NAME
# (`postgres`), not localhost — containers share a network, not a loopback.
# Must stay in sync with the three values above.
#   local (running `next dev` against the container):
#     postgresql://fancy:PASSWORD@localhost:5432/fancy
#   in Compose:
DATABASE_URL=postgresql://fancy:PASSWORD@postgres:5432/fancy

# Connection pool ceiling for the app. Keep comfortably under Postgres'
# max_connections (default 100), leaving headroom for psql, backups and
# drizzle-kit. One web container does not need many.
# DATABASE_POOL_MAX=10


# ===========================================================================
# AUTH — Better Auth (replaces Supabase Auth)
# ===========================================================================
# Signs session cookies and verification/reset tokens. SERVER ONLY.
# Generate with:  openssl rand -base64 32
# Rotating it invalidates every active session — expected, just noisy.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32

# Canonical origin Better Auth builds its callback + email-link URLs from.
# Same value as NEXT_PUBLIC_SITE_URL. Origin only, no trailing slash. If this
# is wrong, OAuth callbacks and every emailed auth link break.
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in — the credentials that used to live in the Supabase dashboard
# now live here. Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client ID (Web application).
# Authorised redirect URI is now OURS, not Supabase's:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
# Leave blank to keep Google sign-in dormant (email + magic link still work).
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxx


# ===========================================================================
# STORAGE — MinIO container (replaces Supabase Storage)
# ===========================================================================
# Holds product images AND videos. Uploads go browser → MinIO directly via a
# presigned PUT, so large videos never stream through the Next.js container.
#
# Root credentials bootstrap the `minio` service. Treat them like the DB
# password: used to create the bucket and the app service account, then left
# alone. The APP does NOT authenticate with these.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=generate-a-long-random-password

# Bucket holding product media. Public-read (product photos are public);
# writes are presigned and admin-gated by the app.
S3_BUCKET=product-media

# Where the SERVER reaches MinIO — internal Compose network, plain HTTP, never
# leaves the host. Service name again, not localhost.
S3_ENDPOINT=http://minio:9000

# MinIO ignores regions but the S3 SDK requires one. Any value; keep it stable
# (it is part of the signature).
S3_REGION=us-east-1

# Least-privilege service account for the app, created in the MinIO console
# (Identity → Service Accounts) and scoped to S3_BUCKET only. SERVER ONLY.
# Do NOT put the root credentials here.
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx

# Browser-facing base URL for media — the public origin Caddy maps to MinIO.
# Used for three things, all of which break if it is wrong:
#   1. <img>/<video> src, via resolveMediaUrl()  (needs NEXT_PUBLIC_ to reach
#      client components like ProductCard)
#   2. the host presigned upload URLs are SIGNED against — a mismatch with the
#      browser's actual request host fails the signature
#   3. next.config.ts images.remotePatterns
# Point it at a subdomain (media.your-domain.com) or a path Caddy proxies.
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/product-media

# Upload ceilings, in megabytes. Previously hardcoded in src/lib/upload-media.ts
# and capped at Supabase's 50MB project limit — that ceiling is gone, these are
# now genuinely ours. Enforced client-side for fast failure AND server-side when
# the presigned URL is issued.
MEDIA_MAX_IMAGE_MB=25
MEDIA_MAX_VIDEO_MB=200


# ===========================================================================
# DEPLOYMENT — VPS / Docker / Caddy
# ===========================================================================
# Domains Caddy serves and requests certificates for.
APP_DOMAIN=your-domain.com
MEDIA_DOMAIN=media.your-domain.com

# Let's Encrypt registration + expiry notices.
ACME_EMAIL=you@your-domain.com


# ===========================================================================
# PAYMENTS
# ===========================================================================
# Leave a key blank to keep that provider dormant (pay-on-delivery).
# Use TEST keys first, prove the flow end to end, then swap to live keys.
#
# Paystack settles NGN + USD; Stripe settles EUR + GBP. Routing is automatic by
# the order's currency (see src/infrastructure/payments/providers.ts).
#
# Paystack (SERVER ONLY secret; public key reserved for future inline checkout)
# PAYSTACK_SECRET_KEY=sk_test_xxx
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
#
# Stripe (SERVER ONLY secret + webhook signing secret from the dashboard, for
# the endpoint https://<your-site>/api/stripe/webhook, or `stripe listen`)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx


# ===========================================================================
# APP
# ===========================================================================
# Frontend URL — the canonical storefront origin. Payment redirect/callback
# URLs, email + unsubscribe links, sitemap/OG metadata and the default email
# sending domain are all built from it. Origin only: scheme + host (+ port), no
# trailing slash. Must be the real origin in production, else callbacks and
# email links point at localhost. Keep BETTER_AUTH_URL identical to it.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000        # prod: https://your-domain.com

# AI Concierge (Anthropic) — SERVER ONLY. The floating assistant only appears
# when this key is present AND an admin enables it in Admin → AI Concierge.
# ANTHROPIC_API_KEY=sk-ant-...

# Cron — the `ofelia` container in docker-compose.yml sends this header when
# it fires the scheduled endpoints.
# When set, /api/cron/* requires `Authorization: Bearer <CRON_SECRET>`.
# Guards both the newsletter and payment-reconciliation cron endpoints.
# CRON_SECRET=generate-a-long-random-string


# ===========================================================================
# EMAIL (and it gains a job in Phase 3)
# ===========================================================================
# Resend is the house provider, and carries EVERY message the app sends itself:
# order confirmations, payment receipts, status/tracking updates, colour-request
# alerts, the concierge hand-off alert, and the Privé Circle newsletter. The
# other providers below are drop-in escape hatches.
#
# Mail only lands once BOTH are true:
#   1. RESEND_API_KEY is set (resend.com/api-keys — "Sending" access suffices).
#   2. EMAIL_FROM's domain is verified in Resend → Domains, with the DKIM/SPF
#      records it issues added to that domain's DNS. Resend cannot send from an
#      unverified domain, and never from gmail.com — which is why replies are
#      routed with EMAIL_REPLY_TO instead of sending AS the gmail mailbox.
# Unset: dev logs each send; production logs an error rather than a silent OK.
#
# From Phase 3 this layer ALSO carries the auth mail (confirmation, password
# reset, magic link) that Supabase used to send. The separate SMTP wiring in
# the Supabase dashboard goes away — one sender, one set of templates.
#
# RESEND_API_KEY=re_xxx
# EMAIL_PROVIDER=resend        # resend|mailchimp|klaviyo|brevo|mailgun|ses|postmark|convertkit
# EMAIL_FROM="Fancy Finery <orders@your-domain.com>" # verified domain; quote it
# EMAIL_REPLY_TO=you@gmail.com # where customer replies land; no verification needed
# IP_HASH_SALT=change-me       # salts the hashed signup IPs used for rate limiting
#
# NEWSLETTER_PROVIDER is the former name of EMAIL_PROVIDER, still honoured.
# POSTMARK_SERVER_TOKEN=xxx
# POSTMARK_STREAM=broadcast
# BREVO_API_KEY=xkeysib-xxx
# MAILGUN_API_KEY=key-xxx
# MAILGUN_DOMAIN=mg.your-domain.com
# KLAVIYO_API_KEY=pk_xxx
# MAILCHIMP_API_KEY=xxx        # Mandrill (Mailchimp Transactional) key
# CONVERTKIT_API_KEY=xxx
# AWS_SES_ACCESS_KEY=xxx       # SES also needs the SDK — see email-provider.ts
