# ---------------------------------------------------------------------------
# Fancy Finery — environment variables
# Copy to `.env` and fill in. `.env*` is git-ignored; never commit real values.
# ---------------------------------------------------------------------------

# Supabase — server-side (new API key format)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx      # browser-safe (RLS enforced)
SUPABASE_SECRET_KEY=sb_secret_xxx                # SERVER ONLY — bypasses RLS
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Supabase — browser (mirror of the two browser-safe values above).
# Next.js only exposes vars prefixed NEXT_PUBLIC_ to client bundles.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Paystack (added in Phase 4)
# PAYSTACK_SECRET_KEY=sk_test_xxx                # SERVER ONLY
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# App
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
